POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# PHP connection inside the Docker network, must match POSTGRES_* above
DB_USERNAME=app
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=app

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Public address of the app, without a trailing slash
APP_URL=http://localhost:8080

# From the Discord Developer Portal. Add APP_URL/auth/discord/callback under OAuth2 redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The bot token, from Bot > Reset Token in the same app. Without it the bot does not start
# On the same page turn on Message Content Intent, or Discord does not let the bot in
DISCORD_BOT_TOKEN=
